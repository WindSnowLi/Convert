include README.md
include LICENSE
include requirements.txt
include pyproject.toml
include setup.py

recursive-include src/media_converter/templates *.html
recursive-include src/media_converter/static *
recursive-include docs *.md
recursive-include scripts *.sh *.bat *.ps1

exclude reorganize_project.sh
exclude reorganize_project.bat

global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo
